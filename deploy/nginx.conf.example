# Install under /etc/nginx/sites-available and enable after issuing the certificate.
# Define the limit_req_zone once in nginx's http context (conf.d/agentsim-limits.conf).
server {
    listen 80;
    listen [::]:80;
    server_name agentsim.example.com;
    access_log off;
    location /.well-known/acme-challenge/ { root /var/www/agentsim-acme; }
    location / { return 301 https://agentsim.example.com$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name agentsim.example.com;
    ssl_certificate /etc/letsencrypt/live/agentsim.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agentsim.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    client_max_body_size 15m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location = /api/site/login {
        limit_req zone=agentsim_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 3900s;
    }
}
